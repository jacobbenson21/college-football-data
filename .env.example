# Copy this file to .env and fill in real values. Never commit .env.

# CollegeFootballData API (https://collegefootballdata.com/key)
CFBD_API_KEY=

# AWS (S3 raw/processed layers)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-1
S3_BUCKET=

# Snowflake (warehouse load)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=CFB_WH
SNOWFLAKE_DATABASE=CFB
SNOWFLAKE_ROLE=ACCOUNTADMIN
